{
  "name": "goji",
  "description": "Project GojiJS",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "postinstall": "yarn create-config && lerna run prepublishOnly",
    "lint": "eslint --color .",
    "prettier": "prettier --list-different \"**/*.@(js|jsx|ts|tsx|json|md|yml|yaml|css)\"",
    "prettier:fix": "prettier --write \"**/*.@(js|jsx|ts|tsx|json|md|yml|yaml|css)\"",
    "create-config": "beemo create-config",
    "build": "lerna run build",
    "test": "jest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/airbnb/goji.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/airbnb/goji/issues"
  },
  "homepage": "https://github.com/airbnb/goji#readme",
  "devDependencies": {
    "@beemo/cli": "^2.0.1",
    "@beemo/core": "^2.0.1",
    "@eslint/eslintrc": "^3.3.7",
    "@goji/beemo-dev": "^1.5.0",
    "eslint": "^9.39.5",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.17.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.4.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "lerna": "^10.1.1",
    "prettier": "2.7.1",
    "typescript-eslint": "^8.72.1",
    "webpack": "^5.112.2"
  },
  "packageManager": "yarn@4.18.1",
  "resolutions": {
    "webpackbar": "^7.0.0",
    "@babel/types": "^7.29.11"
  }
}
