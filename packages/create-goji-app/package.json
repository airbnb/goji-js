{
  "name": "create-goji-app",
  "version": "1.5.0",
  "description": "Create GojiJS App",
  "main": "index.js",
  "repository": "https://github.com/airbnb/goji-js",
  "license": "MIT",
  "bin": "./bin/create-goji-app.js",
  "scripts": {
    "prebuild": "npm run clean",
    "clean": "rimraf dist",
    "start": "tsc -watch",
    "build": "npm run build:esm && npm run build:cjs",
    "build:esm": "tsc --module esnext --outDir dist/esm",
    "build:cjs": "tsc --module commonjs --outDir dist/cjs",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "chalk": "^4.1.2",
    "ejs": "^3.1.10",
    "globby": "^11.0.1",
    "mkdirp": "^1.0.4",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.6",
    "@babel/runtime": "^7.15.4",
    "@goji/core": "^1.5.0",
    "@types/jest": "^27.0.3",
    "@types/node": "^17.0.0",
    "@types/rimraf": "^3.0.2",
    "core-js": "^3.16.0",
    "react": "^17.0.2",
    "rimraf": "^3.0.2",
    "typescript": "^4.3.5"
  }
}
